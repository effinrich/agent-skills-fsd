{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .agents/skills/feature-sliced-design/scripts/shell-guard.mjs",
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "node .agents/skills/feature-sliced-design/scripts/stop-gate.mjs",
        "timeout": 600,
        "loop_limit": 3
      }
    ]
  }
}
